# ~/.zshrc — managed by chezmoi
# Edit source: ~/bootstrap/chezmoi/dot_zshrc.tmpl
# Apply changes: chezmoi apply

# ── Homebrew ──────────────────────────────────────────────────────────────────
{{- if eq .chezmoi.arch "arm64" }}
eval "$(/opt/homebrew/bin/brew shellenv)"
{{- else }}
eval "$(/usr/local/bin/brew shellenv)"
{{- end }}

# ── PATH: ~/.local/bin ────────────────────────────────────────────────────────
export PATH="${HOME}/.local/bin:${PATH}"

# ── mise (runtime version manager) ───────────────────────────────────────────
eval "$(mise activate zsh)"

# ── Starship prompt ───────────────────────────────────────────────────────────
eval "$(starship init zsh)"

# ── Oh My Zsh ─────────────────────────────────────────────────────────────────
export ZSH="${HOME}/.oh-my-zsh"
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)
source "${ZSH}/oh-my-zsh.sh"

# ── zoxide (smart cd) ─────────────────────────────────────────────────────────
eval "$(zoxide init zsh)"

# ── fzf ───────────────────────────────────────────────────────────────────────
[[ -f "${HOME}/.fzf.zsh" ]] && source "${HOME}/.fzf.zsh"

# ── Modern CLI aliases ────────────────────────────────────────────────────────
alias ls='eza --icons --group-directories-first'
alias ll='eza --icons --group-directories-first -la'
alias lt='eza --icons --tree --level=2'
alias cat='bat --paging=never'
alias grep='rg'
alias find='fd'
alias cd='z'           # zoxide
alias top='procs'

# ── Git aliases ───────────────────────────────────────────────────────────────
alias g='git'
alias lg='lazygit'
alias gst='git status'
alias gco='git checkout'
alias gcb='git checkout -b'
alias glog='git log --oneline --graph --decorate'

# ── Python (uv) ───────────────────────────────────────────────────────────────
alias pip='uv pip'
alias venv='uv venv'

# ── kubectl ───────────────────────────────────────────────────────────────────
if command -v kubectl &>/dev/null; then
  source <(kubectl completion zsh)
  alias k='kubectl'
  compdef k=kubectl
fi

# ── gcloud ────────────────────────────────────────────────────────────────────
{{- if eq .chezmoi.arch "arm64" }}
_gcloud_path="/opt/homebrew/share/google-cloud-sdk"
{{- else }}
_gcloud_path="/usr/local/share/google-cloud-sdk"
{{- end }}
[[ -f "${_gcloud_path}/path.zsh.inc" ]]       && source "${_gcloud_path}/path.zsh.inc"
[[ -f "${_gcloud_path}/completion.zsh.inc" ]] && source "${_gcloud_path}/completion.zsh.inc"

# ── AI CLI auto-update ────────────────────────────────────────────────────────
[[ -f "${HOME}/.local/bin/ai-shell-init.zsh" ]] && source "${HOME}/.local/bin/ai-shell-init.zsh"

# ── User customizations (merge your old ~/.zshrc content below) ───────────────
