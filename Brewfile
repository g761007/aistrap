# Bootstrap Brewfile — managed by ./install.sh
# Edit this file to add/remove packages, then re-run: brew bundle --file=Brewfile

# ── Taps ──────────────────────────────────────────────────────────────────────
tap "homebrew/bundle"

# ── CLI essentials ────────────────────────────────────────────────────────────
brew "git"
brew "git-lfs"
brew "gh"                      # GitHub CLI
brew "curl"
brew "wget"
brew "jq"
brew "tree"
brew "htop"

# ── Modern CLI replacements ───────────────────────────────────────────────────
brew "eza"                     # ls replacement
brew "bat"                     # cat replacement
brew "ripgrep"                 # grep replacement
brew "fd"                      # find replacement
brew "fzf"                     # fuzzy finder
brew "zoxide"                  # smart cd
brew "lazygit"                 # git TUI
brew "git-delta"               # better git diff
brew "procs"                   # ps replacement
brew "dust"                    # du replacement

# ── Runtime management ────────────────────────────────────────────────────────
brew "mise"                    # runtime version manager (replaces asdf/nvm/rbenv)

# ── Shell & prompt ────────────────────────────────────────────────────────────
brew "starship"                # cross-shell prompt
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# ── Python tooling ────────────────────────────────────────────────────────────
brew "uv"                      # pip/venv/poetry replacement

# ── Infrastructure ────────────────────────────────────────────────────────────
brew "kubectl"
brew "helm"
brew "k9s"
brew "awscli"
brew "terraform"

# ── Editor ────────────────────────────────────────────────────────────────────
brew "neovim"

# ── Security ─────────────────────────────────────────────────────────────────
brew "gnupg"
brew "pinentry-mac"

# ── Dotfiles management ───────────────────────────────────────────────────────
brew "chezmoi"

# ── Misc utilities ────────────────────────────────────────────────────────────
brew "tmux"
brew "hyperfine"               # benchmarking

# ── GUI apps (casks) ─────────────────────────────────────────────────────────
cask "ghostty"                 # terminal emulator (already installed — idempotent)
cask "warp"                    # AI terminal
cask "visual-studio-code"
cask "orbstack"                # Docker/Kubernetes (replaces Docker Desktop)
cask "raycast"                 # launcher
cask "tableplus"               # database GUI
cask "bruno"                   # API client
cask "cleanshot"               # screenshot tool
cask "rectangle"               # window manager
cask "google-cloud-sdk"        # gcloud CLI (installed as cask for auto-updates)
cask "1password-cli"           # secrets management

# ── Fonts ─────────────────────────────────────────────────────────────────────
cask "font-sauce-code-pro-nerd-font"
cask "font-jetbrains-mono-nerd-font"
cask "font-roboto-mono-nerd-font"
